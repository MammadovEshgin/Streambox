{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streambox-tmdb-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-05-11",
  // Served on workers.dev AND our own zone: Bakcell's mobile network can't
  // reach *.workers.dev, and the app fails over to this host (src/api/tmdb.ts).
  "routes": [
    { "pattern": "tmdb.streamboxapp.stream", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "ALLOWED_ORIGINS": "",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    // Abuse ceiling, not a throttle: mobile CGNAT puts many users behind one
    // IP, and the app's legitimate cold-start burst is ~40+ requests. Cache
    // hits no longer count against this (cache lookup precedes the limiter).
    "RATE_LIMIT_MAX_REQUESTS": "600",
    "SUPABASE_URL": "https://zbeexmqmcwtlsbbuuqor.supabase.co"
  }
}
