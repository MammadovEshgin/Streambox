{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streambox-push-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "SUPABASE_URL": "",
    "EXPO_PUSH_ENDPOINT": "https://exp.host/--/api/v2/push/send"
  }
  // Secrets (do NOT commit): set with
  //   wrangler secret put SUPABASE_SERVICE_ROLE_KEY   (Supabase dashboard →
  //     Settings → API → service_role key; bypasses RLS to read push tokens)
  //   wrangler secret put WEBHOOK_SECRET              (a random string; the
  //     Supabase Database Webhook must send it as the
  //     `x-streambox-webhook-secret` header)
  // Also set SUPABASE_URL in `vars` above (or via `wrangler secret`) to the
  // project URL https://<ref>.supabase.co
}
